# Supabase → Project Settings → API থেকে কপি করুন
# পুরোনো ফরম্যাট: anon public key
# নতুন ফরম্যাট: publishable key (sb_publishable_...)
# যেকোনো একটা দিলেই চলবে।

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# নতুন প্রজেক্ট হলে:
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# পুরোনো প্রজেক্ট হলে (এটাও চলবে):
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ⚠️ secret / service_role key কখনো এখানে দিও না — ব্রাউজারে চলে যাবে।
